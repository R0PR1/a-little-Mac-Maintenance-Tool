#!/usr/bin/env bash

set -euo pipefail

# Follow symlinks so a launcher in ~/.local/bin (or Homebrew's bin/)
# still finds lib/mm next to the real script, not ~/.local/lib/mm.
mm_script_dir() {
    local source="${BASH_SOURCE[0]}"
    local dir
    while [[ -L "$source" ]]; do
        dir="$(cd "$(dirname "$source")" && pwd)" || return 1
        source="$(readlink "$source")"
        [[ "$source" != /* ]] && source="${dir}/${source}"
    done
    cd "$(dirname "$source")" && pwd
}

SCRIPT_DIR="$(mm_script_dir)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
LIB_DIR="${MM_LIB_DIR:-$PROJECT_DIR/lib/mm}"

if [[ ! -f "$LIB_DIR/output.sh" ]]; then
    printf 'mm: cannot find libraries at %s\n' "$LIB_DIR" >&2
    printf 'The command was launched from %s\n' "${BASH_SOURCE[0]}" >&2
    printf 'Reinstall from a clone with: make install\n' >&2
    exit 2
fi

# shellcheck source=../lib/mm/output.sh
source "$LIB_DIR/output.sh"
# shellcheck source=../lib/mm/utils.sh
source "$LIB_DIR/utils.sh"
# shellcheck source=../lib/mm/config.sh
source "$LIB_DIR/config.sh"
# shellcheck source=../lib/mm/brew.sh
source "$LIB_DIR/brew.sh"
# shellcheck source=../lib/mm/health.sh
source "$LIB_DIR/health.sh"
# shellcheck source=../lib/mm/macos.sh
source "$LIB_DIR/macos.sh"
# shellcheck source=../lib/mm/security.sh
source "$LIB_DIR/security.sh"
# shellcheck source=../lib/mm/launchd.sh
source "$LIB_DIR/launchd.sh"
# shellcheck source=../lib/mm/self_update.sh
source "$LIB_DIR/self_update.sh"
# shellcheck source=../lib/mm/json.sh
source "$LIB_DIR/json.sh"
# shellcheck source=../lib/mm/menubar.sh
source "$LIB_DIR/menubar.sh"

main() {
    local command="${1:-status}"
    shift || true

    case "$command" in
        --json)
            mm_status --json
            ;;
        status)
            mm_status "$@"
            ;;
        update)
            mm_run_locked update mm_brew_update "$@"
            ;;
        upgrade)
            mm_run_locked upgrade mm_brew_upgrade "$@"
            ;;
        doctor)
            mm_doctor "$@"
            ;;
        security)
            mm_security "$@"
            ;;
        logs)
            mm_logs "$@"
            ;;
        config)
            mm_config_command "$@"
            ;;
        schedule)
            mm_schedule_command "$@"
            ;;
        menubar)
            mm_menubar_command "$@"
            ;;
        self-update)
            mm_self_update "$@"
            ;;
        version|--version|-v)
            mm_version
            ;;
        help|--help|-h)
            mm_help
            ;;
        internal)
            mm_internal "$@"
            ;;
        *)
            mm_error "Unknown command: $command"
            mm_help >&2
            return 64
            ;;
    esac
}

main "$@"
